{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "R41-T043 simulated text classification record",
  "description": "One fictional pipeline-fixture row; labels are arbitrary binary values, not language identifiers.",
  "type": "object",
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "integer",
      "enum": [0, 1]
    }
  },
  "required": ["record_id", "text", "label"],
  "additionalProperties": false
}

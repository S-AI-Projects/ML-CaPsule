{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutoMPGRegressionContract",
  "description": "Schema definition for Auto MPG regression minimal baseline fixture (Task R41-T023)",
  "type": "object",
  "required": ["record_id", "x1", "x2", "target"],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique record identifier (e.g. r1..r6)"
    },
    "x1": {
      "type": "number",
      "description": "Scalar feature in {0, 1, 2, 3, 4, 5}"
    },
    "x2": {
      "type": "number",
      "description": "Constant secondary feature (1.0)"
    },
    "target": {
      "type": "number",
      "description": "Deterministic regression target following formula target = 2 * x1 + 1"
    },
    "split": {
      "type": "string",
      "enum": ["train", "validation", "test"],
      "description": "Partition assignment"
    }
  },
  "additionalProperties": true
}
